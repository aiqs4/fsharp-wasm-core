<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FSharp.WasmCore.Tests</AssemblyName>
    <!-- Run tests via Expecto's own Main -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.Interfaces.fs" />
    <Compile Include="Tests.Math.fs" />
    <Compile Include="Tests.Dictionary.fs" />
    <Compile Include="Tests.StringBuilder.fs" />
    <Compile Include="Tests.ResizeArray.fs" />
    <Compile Include="Tests.Stack.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../FSharp.Wasm.Core/FSharp.WasmCore.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto"        Version="10.2.1" />
    <PackageReference Include="Expecto.FsCheck" Version="10.2.1" />
    <PackageReference Include="FsCheck"        Version="2.16.6" />
  </ItemGroup>
</Project>
